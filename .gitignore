# ============================================================================
# My Money Tracker — Git Ignore & Personal Financial Data Protection Rules
# ============================================================================

# 1. Dependencies & Package Managers
node_modules/
**/node_modules/
.pnp
.pnp.js
.pnpm-debug.log*
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# 2. Production Build Output & Caches
dist/
**/dist/
dist-ssr/
build/
.vite/
**/.vite/
*.tsbuildinfo

# 3. Environment Variables & Local Secrets (NEVER COMMIT)
.env
.env.*
!.env.example
*.pem
*.key

# 4. Personal Financial Backups, Exports & Transaction Records (STRICTLY EXCLUDED)
# Never commit personal JSON backups or exported financial CSV reports to GitHub!
*.csv
**/*.csv
*Backup*.json
*backup*.json
MyMoneyTracker_*.json
MyMoneyTracker_*.csv
*.sqlite
*.sqlite3
*.db
*.idb
personal-data/
backups/
exports/

# 5. Editor, OS & Temporary Development Files
.vscode/*
